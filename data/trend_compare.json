  "verdict": [
    "\uc9c0\uae08\uc740 \uc9c4\uc785 5\uac70\ub798\uc77c\ucc28\uc774\uace0 +4.2% \ub2e4. \uacfc\uac70 \uad6d\uba74 9\uac1c\uc758 \uac19\uc740 \uc2dc\uc810 \uc911\uc559\uac12\uc740 -0.4% \uc774\ubbc0\ub85c \uc911\uc559\uac12\ubcf4\ub2e4 \uc704, \uacfc\uac70 \ubc94\uc704(-7.6% ~ +17.0%) \uc548\uc5d0 \uc788\ub2e4.",
    "\uc9c4\uc785 \ub099\ud3ed\uc774 \ube44\uc2b7\ud55c '\uc595\uc74c' \uad6d\uba74 5\uac1c\ub9cc \ubcf4\uba74 \uac19\uc740 \uc2dc\uc810 \uc911\uc559\uac12\uc774 -1.3% \uc774\uace0, \uc9c0\uae08\uc740 \uadf8\uc911 6\uac1c \uc911 6\ubc88\uc9f8\ub2e4. \ub099\ud3ed\uc774 \uae4a\uc744\uc218\ub85d \uc774\ud6c4 \uc218\uc775\uc774 \ucef8\uc73c\ubbc0\ub85c(\uc9c4\uc785\ub099\ud3ed -> 6\uac1c\uc6d4 \uc0c1\uad00 -0.84), \uc804\uccb4\ub97c \ubb49\ub6b1\uadf8\ub9b0 \uc911\uc559\uac12\uc740 \uc9c0\uae08 \uc0c1\ud669\ubcf4\ub2e4 \ub099\uad00\uc801\uc774\ub2e4. \uac19\uc740 \uadf8\ub8f9\ub07c\ub9ac \ube44\uad50\ud55c \ucabd\uc774 \ub9de\ub2e4.",
    "1\uc8fc\ucc28 \uc218\uc775\ub960\uacfc 6\uac1c\uc6d4 \uacb0\uacfc\ub294 \uacfc\uac70 9\uac1c \uad6d\uba74\uc5d0\uc11c \ud53c\uc5b4\uc2a8 +0.78 / \uc21c\uc704 +0.77, \ud558\ub098\uc529 \ube7c\ub3c4 +0.72~+0.88 \ub85c \ubc29\ud5a5\uc774 \uc720\uc9c0\ub41c\ub2e4 \u2014 \ucd08\ubc18 \ud750\ub984\uc774 \ub05d\uc744 \uc5b4\ub290 \uc815\ub3c4 \uc608\uace0\ud588\ub2e4\ub294 \ub73b\uc774\ub2e4. \ub099\ud3ed \uadf8\ub8f9 \uc548\uc5d0\uc11c\ub9cc \ubd10\ub3c4 +0.58 \ub85c \ub0a8\uc73c\ubbc0\ub85c \ub099\ud3ed\uc758 \uadf8\ub9bc\uc790\ub9cc\uc740 \uc544\ub2c8\uc9c0\ub9cc, \uadf8 \ud45c\ubcf8\uc740 5\uac1c\ubfd0\uc774\ub2e4.",
    "\uc9c0\uae08\ubd80\ud130 \uc55e\uc73c\ub85c\ub294, \ubb34\uc791\uc704 \uc9c4\uc785 \ub300\ube44 \uc6b0\uc704\uac00 3\uac1c\uc6d4 8/9(\uad6c\uac04 56~98%, \ubb34\uc791\uc704 52%) \u00b7 6\uac1c\uc6d4 9/9(\uad6c\uac04 70~100%, \ubb34\uc791\uc704 54%) \uc5d0\uc11c \ud655\uc778\ub41c\ub2e4. \uad6c\uac04 \ud558\ud55c\uc774 \ubb34\uc791\uc704\ubcf4\ub2e4 \uc704\uc77c \ub54c\ub9cc '\uc6b0\uc704' \ub77c\uace0 \uc801\uc5c8\ub2e4. \ubc18\uba74 1\uc8fc(44% vs \ubb34\uc791\uc704 47%) \u00b7 12\uac1c\uc6d4(62% vs \ubb34\uc791\uc704 66%) \ub294 \uc6b0\uc704\uac00 \uc5c6\ub2e4 \u2014 \uae30\ub2e4\ub9bc\uc5d0\ub3c4 \uc720\ud6a8 \uad6c\uac04\uc774 \uc788\ub2e4\ub294 \ub73b\uc774\ub2e4.",
    "\uacfc\uac70 \uad6d\uba74 +10% \ub294 9/9\uac1c\uac00 \uc911\uc559\uac12 17\uac70\ub798\uc77c \u00b7 +20% \ub294 9/9\uac1c\uac00 \uc911\uc559\uac12 25\uac70\ub798\uc77c \u00b7 +30% \ub294 9/9\uac1c\uac00 \uc911\uc559\uac12 39\uac70\ub798\uc77c \ub9cc\uc5d0 \ub2ff\uc558\ub2e4. \ub2e4\ub9cc \uadf8 \uc0ac\uc774 6\uac1c\uc6d4 \ub0b4 \ucd5c\uc545\uc740 \uc911\uc559\uac12 -7.9% \uc600\uace0, \uc9c0\uae08\uc740 5\uac70\ub798\uc77c\uae4c\uc9c0 -3.5% \ub2e4. \uae30\ub2e4\ub9ac\ub294 \ub3d9\uc548 \uacac\ub38c\uc57c \ud558\ub294 \ud3ed\uc774\ub2e4.",
    "\ud45c\ubcf8\uc740 \uad6d\uba74 9\uac1c\uc774\uace0 \uadf8\uc911 \ud070 \uc218\uc775\uc740 2023\ub144 \ud68c\ubcf5\uc7a5\uc5d0 \ubab0\ub824 \uc788\ub2e4. \ud55c \uad6d\uba74\uc774 \ub4e4\uace0 \ub098\uba74 \uc911\uc559\uac12\ub3c4 \uc0c1\uad00\ub3c4 \ud06c\uac8c \uc6c0\uc9c1\uc778\ub2e4. \uc774 \ube44\uad50\ub294 '\uc9c0\uae08\uc774 \uacfc\uac70\uc640 \uacac\uc918 \uc774\uc0c1\ud55c\uac00' \ub97c \ubcf4\ub294 \ub9e5\ub77d\uc774\uc9c0 \uc608\uce21\uc774 \uc544\ub2c8\ub2e4."
  ]
